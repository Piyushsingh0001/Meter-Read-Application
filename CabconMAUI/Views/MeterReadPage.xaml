                    </Border>

                    <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedReadDataOption}" Value="1">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Nameplate" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="15"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="Capture Object" Command="{Binding CaptureNameplateObjectCommand}" Style="{StaticResource OutlineButton}"/>
                                <Button Grid.Column="1" Text="Read Data" Command="{Binding ReadNameplateDataCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Grid.Column="2" Text="Close" Command="{Binding CloseNameplateObjectCommand}" Style="{StaticResource OutlineButton}"/>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding ShowNameplatePanel}" Spacing="0">
                                <ScrollView Orientation="Horizontal">
                                    <VerticalStackLayout WidthRequest="900" Spacing="0">
                                        <Grid ColumnDefinitions="60,80,160,90,*,160" BackgroundColor="{StaticResource SectionBg}" Padding="8,10">
                                            <Label Text="S.No." FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="Class ID" FontAttributes="Bold"/>
                                            <Label Grid.Column="2" Text="OBIS Code" FontAttributes="Bold"/>
                                            <Label Grid.Column="3" Text="Attribute" FontAttributes="Bold"/>
                                            <Label Grid.Column="4" Text="Parameter Name" FontAttributes="Bold"/>
                                            <Label Grid.Column="5" Text="Value" FontAttributes="Bold"/>
                                        </Grid>
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NameplateRows}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="60,80,160,90,*,160" Padding="8,10" BackgroundColor="White">
                                                        <Label Text="{Binding SerialNumber}"/>
                                                        <Label Grid.Column="1" Text="{Binding ClassId}"/>
                                                        <Label Grid.Column="2" Text="{Binding ObisCode}"/>
                                                        <Label Grid.Column="3" Text="{Binding Attribute}"/>
                                                        <Label Grid.Column="4" Text="{Binding ParameterName}"/>
                                                        <Label Grid.Column="5" Text="{Binding Value}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedReadDataOption}" Value="2">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="RTC (Clock)" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="15"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="Capture Object" Command="{Binding CaptureRtcObjectCommand}" Style="{StaticResource OutlineButton}"/>
                                <Button Grid.Column="1" Text="Read Data" Command="{Binding ReadRtcDataCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Grid.Column="2" Text="Close" Command="{Binding CloseRtcObjectCommand}" Style="{StaticResource OutlineButton}"/>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding ShowRtcPanel}" Spacing="10" Margin="0,10,0,0">
                                <Label Text="Meter Clock:" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="{Binding Timestamp}" FontSize="16" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 12" Padding="12" IsVisible="False">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedReadDataOption}" Value="3">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Billing Profile Read Out" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" FontSize="15"/>
                            
                            <!-- Filtering Options -->
                            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                                <HorizontalStackLayout Spacing="10">
                                    <RadioButton Content="Read Complete" IsChecked="{Binding IsBillingReadComplete}" />
                                    <RadioButton Content="Read Last" IsChecked="{Binding IsBillingReadLast}" />
                                    <Picker ItemsSource="{Binding BillingIndices}" SelectedIndex="{Binding BillingLastNIndex}" IsEnabled="{Binding IsBillingReadLast}" WidthRequest="60" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <RadioButton Content="Read Between" IsChecked="{Binding IsBillingReadBetween}" />
                                    <Label Text="From:" VerticalOptions="Center" />
                                    <Picker ItemsSource="{Binding BillingIndices}" SelectedIndex="{Binding BillingFromIndex}" IsEnabled="{Binding IsBillingReadBetween}" WidthRequest="60" />
                                    <Label Text="To:" VerticalOptions="Center" />
                                    <Picker ItemsSource="{Binding BillingIndices}" SelectedIndex="{Binding BillingToIndex}" IsEnabled="{Binding IsBillingReadBetween}" WidthRequest="60" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="Capture Object" Command="{Binding CaptureBillingObjectCommand}" Style="{StaticResource OutlineButton}"/>
                                <Button Grid.Column="1" Text="Read Data" Command="{Binding ReadBillingDataCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Grid.Column="2" Text="Close" Command="{Binding CloseBillingObjectCommand}" Style="{StaticResource OutlineButton}"/>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding ShowBillingPanel}" Spacing="0" Margin="0,10,0,0">
                                <ScrollView Orientation="Horizontal">
