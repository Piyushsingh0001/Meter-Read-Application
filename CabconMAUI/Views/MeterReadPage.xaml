                                            Command="{Binding OpenBillingProfileCommand}"
                                            CommandParameter="3"
                                            Style="{StaticResource OutlineButton}"
                                            HeightRequest="46"
                                            HorizontalOptions="Fill">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding SelectedReadDataOption}" Value="3">
