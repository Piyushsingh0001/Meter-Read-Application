                                            <Label Text="OBIS Code" FontAttributes="Bold" WidthRequest="120" />
                                            <Label Text="Attribute" FontAttributes="Bold" WidthRequest="65" />
                                            <Label Text="Parameter Name" FontAttributes="Bold" WidthRequest="150" />
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding BillingColumnHeaders}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding .}" FontAttributes="Bold" WidthRequest="150" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- Dynamic Rows -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BillingRows}" Spacing="0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Padding="8,10" BackgroundColor="White">
