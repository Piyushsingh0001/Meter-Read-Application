                                                        <Label Text="{Binding ClassId}" WidthRequest="60" />
                                                        <Label Text="{Binding ObisCode}" WidthRequest="120" />
                                                        <Label Text="{Binding Attribute}" WidthRequest="65" />
                                                        <Label Text="{Binding ParameterName}" WidthRequest="150" FontAttributes="Bold" />
                                                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Values}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Label Text="{Binding .}" WidthRequest="150" />
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
